# Nebula Match — Backend Environment Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB: mongodb://127.0.0.1:27017/nebula_match
# Or MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/nebula_match
MONGODB_URI=mongodb://127.0.0.1:27017/nebula_match

# Client URL for CORS
CLIENT_URL=http://localhost:4000
